{
  "name": "@tiaforge-ui/sinter",
  "version": "0.22.0",
  "description": "Bind JSON APIs to plain HTML: keyed resources, SSE sync, template bindings and optimistic mutations, compiled at build time.",
  "license": "MIT",
  "author": "Tia Heinrich",
  "homepage": "https://github.com/tiaforge/sinter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiaforge/sinter.git"
  },
  "bugs": {
    "url": "https://github.com/tiaforge/sinter/issues"
  },
  "keywords": [
    "html",
    "json",
    "api",
    "rest",
    "sse",
    "server-sent-events",
    "websocket",
    "vite",
    "vite-plugin",
    "compiler",
    "templates",
    "data-binding",
    "optimistic-ui",
    "hypermedia"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./ws": "./dist/ws.js",
    "./retry": "./dist/retry.js",
    "./messages": "./dist/messages.js",
    "./messages/content": "./dist/messages/content.js",
    "./messages/format": "./dist/messages/format.js",
    "./memo": "./dist/memo.js",
    "./compiler": "./dist/compiler/index.js",
    "./vite": "./dist/vite.js",
    "./check": "./dist/check/index.js",
    "./testing": "./dist/testing/index.js",
    "./server": "./dist/server.js",
    "./content": "./dist/content.js",
    "./runtime": "./dist/runtime-entry.js",
    "./runtime/sse": "./dist/sse.js",
    "./runtime/optimistic": "./dist/optimistic.js",
    "./runtime/paginate": "./dist/paginate.js",
    "./runtime/remote": "./dist/remote.js",
    "./runtime/token": "./dist/token.js",
    "./runtime/signed-in": "./dist/signed-in.js",
    "./runtime/for": "./dist/for.js",
    "./runtime/persist": "./dist/persist.js",
    "./runtime/options": "./dist/options.js",
    "./runtime/keys": "./dist/keys.js",
    "./runtime/write-through": "./dist/write-through.js",
    "./runtime/cache": "./dist/cache.js",
    "./runtime/back": "./dist/back.js",
    "./runtime/refresh": "./dist/refresh.js",
    "./runtime/versions": "./dist/versions.js",
    "./runtime/prefetch": "./dist/prefetch.js",
    "./runtime/fields": "./dist/fields.js",
    "./runtime/form": "./dist/form.js",
    "./runtime/select": "./dist/select.js",
    "./runtime/location": "./dist/location.js",
    "./runtime/typing": "./dist/typing.js",
    "./runtime/query-links": "./dist/query-links.js",
    "./runtime/navigate": "./dist/navigate.js",
    "./runtime/swap": "./dist/swap.js",
    "./runtime/call": "./dist/call.js",
    "./runtime/lazy": "./dist/lazy.js",
    "./runtime/debounce": "./dist/debounce.js",
    "./runtime/confirm": "./dist/confirm.js",
    "./runtime/models": "./dist/models.js",
    "./runtime/transition": "./dist/transition.js",
    "./runtime/early": "./dist/early.js",
    "./runtime/nested": "./dist/nested.js",
    "./runtime/lets": "./dist/lets.js",
    "./runtime/dev": "./dist/dev.js",
    "./runtime/components": "./dist/components.js"
  },
  "bin": {
    "sinter": "dist/cli.js"
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "html-custom-data.json",
    "docs/diagnostics.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest run --config bench/runtime/vitest.config.ts",
    "size": "npm run build && node scripts/size.mjs",
    "baseline": "npm run build && node scripts/baseline.mjs",
    "docs": "UPDATE_DOCS=1 vitest run test/docs.test.ts",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "rm -rf dist && npm run build && npm test"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.13",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "css-tree": "^3.2.1",
    "parse5": "^8.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tiaforge-ui/temper": "^0.1.8",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "sass": "^1.108.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "jsdom": ">=24",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
