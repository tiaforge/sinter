{
  "name": "@tiaforge-ui/sinter",
  "version": "0.17.0",
  "description": "Bind JSON APIs to plain HTML: keyed resources, SSE sync, template bindings and optimistic mutations, compiled at build time.",
  "license": "MIT",
  "author": "Tia Heinrich",
  "homepage": "https://github.com/tiaforge/sinter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiaforge/sinter.git"
  },
  "bugs": {
    "url": "https://github.com/tiaforge/sinter/issues"
  },
  "keywords": [
    "html",
    "json",
    "api",
    "rest",
    "sse",
    "server-sent-events",
    "websocket",
    "vite",
    "vite-plugin",
    "compiler",
    "templates",
    "data-binding",
    "optimistic-ui",
    "hypermedia"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./sse": "./dist/sse.js",
    "./ws": "./dist/ws.js",
    "./optimistic": "./dist/optimistic.js",
    "./paginate": "./dist/paginate.js",
    "./remote": "./dist/remote.js",
    "./each": "./dist/each.js",
    "./persist": "./dist/persist.js",
    "./listbox": "./dist/listbox.js",
    "./keys": "./dist/keys.js",
    "./apply": "./dist/apply.js",
    "./cache": "./dist/cache.js",
    "./refresh": "./dist/refresh.js",
    "./retry": "./dist/retry.js",
    "./versions": "./dist/versions.js",
    "./prefetch": "./dist/prefetch.js",
    "./fields": "./dist/fields.js",
    "./form": "./dist/form.js",
    "./select": "./dist/select.js",
    "./location": "./dist/location.js",
    "./typing": "./dist/typing.js",
    "./query-links": "./dist/query-links.js",
    "./call": "./dist/call.js",
    "./lazy": "./dist/lazy.js",
    "./debounce": "./dist/debounce.js",
    "./confirm": "./dist/confirm.js",
    "./models": "./dist/models.js",
    "./transition": "./dist/transition.js",
    "./early": "./dist/early.js",
    "./messages": "./dist/messages.js",
    "./components": "./dist/components.js",
    "./nested": "./dist/nested.js",
    "./defs": "./dist/defs.js",
    "./compiler": "./dist/compiler/index.js",
    "./vite": "./dist/vite.js",
    "./check": "./dist/check/index.js",
    "./testing": "./dist/testing/index.js",
    "./dev": "./dist/dev.js",
    "./server": "./dist/server.js"
  },
  "bin": {
    "sinter": "dist/cli.js"
  },
  "files": [
    "dist",
    "llms.txt",
    "html-custom-data.json",
    "docs/diagnostics.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest run --config bench/runtime/vitest.config.ts",
    "size": "npm run build && node scripts/size.mjs",
    "docs": "UPDATE_DOCS=1 vitest run test/docs.test.ts",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "rm -rf dist && npm run build && npm test"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.13",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "css-tree": "^3.2.1",
    "parse5": "^8.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tiaforge-ui/temper": "^0.1.8",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "playwright": "^1.63.0",
    "sass": "^1.108.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unocss": "^66.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
