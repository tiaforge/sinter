{
  "name": "@tiaforge/sinter",
  "version": "0.1.0-dev",
  "description": "Bind JSON APIs to plain HTML: keyed resources, SSE sync, template bindings and optimistic mutations, compiled at build time.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./sse": "./dist/sse.js",
    "./optimistic": "./dist/optimistic.js",
    "./paginate": "./dist/paginate.js",
    "./persist": "./dist/persist.js",
    "./compiler": "./dist/compiler/index.js",
    "./vite": "./dist/vite.js",
    "./testing": "./dist/testing/index.js"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "parse5": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
