{
  "name": "@tiaforge-ui/sinter",
  "version": "0.3.0",
  "description": "Bind JSON APIs to plain HTML: keyed resources, SSE sync, template bindings and optimistic mutations, compiled at build time.",
  "license": "MIT",
  "author": "Tia Heinrich",
  "homepage": "https://github.com/tiaforge/sinter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiaforge/sinter.git"
  },
  "bugs": {
    "url": "https://github.com/tiaforge/sinter/issues"
  },
  "keywords": [
    "html",
    "json",
    "api",
    "rest",
    "sse",
    "server-sent-events",
    "websocket",
    "vite",
    "vite-plugin",
    "compiler",
    "templates",
    "data-binding",
    "optimistic-ui",
    "hypermedia"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./sse": "./dist/sse.js",
    "./ws": "./dist/ws.js",
    "./optimistic": "./dist/optimistic.js",
    "./paginate": "./dist/paginate.js",
    "./each": "./dist/each.js",
    "./persist": "./dist/persist.js",
    "./listbox": "./dist/listbox.js",
    "./cache": "./dist/cache.js",
    "./compiler": "./dist/compiler/index.js",
    "./vite": "./dist/vite.js",
    "./check": "./dist/check/index.js",
    "./testing": "./dist/testing/index.js",
    "./dev": "./dist/dev.js"
  },
  "bin": {
    "sinter": "dist/cli.js"
  },
  "files": [
    "dist",
    "llms.txt",
    "html-custom-data.json",
    "docs/diagnostics.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "vitest run --config bench/runtime/vitest.config.ts",
    "size": "npm run build && node scripts/size.mjs",
    "docs": "UPDATE_DOCS=1 vitest run test/docs.test.ts",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "rm -rf dist && npm run build && npm test"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.13",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "parse5": "^8.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
