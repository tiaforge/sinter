{
  "name": "@tiaforge/sinter",
  "version": "0.1.0-dev",
  "description": "Bind JSON APIs to plain HTML: keyed resources, SSE sync, template bindings and optimistic mutations, compiled at build time.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./sse": "./dist/sse.js",
    "./ws": "./dist/ws.js",
    "./optimistic": "./dist/optimistic.js",
    "./paginate": "./dist/paginate.js",
    "./persist": "./dist/persist.js",
    "./compiler": "./dist/compiler/index.js",
    "./vite": "./dist/vite.js",
    "./check": "./dist/check/index.js",
    "./testing": "./dist/testing/index.js",
    "./dev": "./dist/dev.js"
  },
  "bin": {
    "sinter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "llms.txt",
    "html-custom-data.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "size": "npm run build && node scripts/size.mjs",
    "docs": "UPDATE_DOCS=1 vitest run test/docs.test.ts"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "parse5": "^8.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
